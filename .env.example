# ---------------------------------------------------------------------------
# AI Email Outreach & Automation Platform — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local (zero setup): SQLite file. Production: PostgreSQL.
# To use PostgreSQL, change prisma/schema.prisma datasource provider to
# "postgresql" and run `npx prisma generate` + `npx prisma db push`.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://outreach:outreach@localhost:5432/outreach"

# --- Redis / queue ---------------------------------------------------------
# Leave REDIS_URL empty to use the in-process queue (dev). Set it (and
# QUEUE_MODE=redis) to use BullMQ workers.
REDIS_URL=""
QUEUE_MODE="auto" # auto | redis | in_process

# --- Auth (application sign-in via Google) ----------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate with: npx auth secret  (or: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET=""

# Google OAuth credentials for APP SIGN-IN (scopes: openid email profile).
# See GOOGLE_CLOUD_SETUP.md for how to create these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Google mailbox authorization (Gmail + Sheets) --------------------------
# Separate OAuth flow for the mailbox connection. Same Google Cloud project.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"

# --- AI --------------------------------------------------------------------
AI_PROVIDER="demo" # demo (no key needed) | openai
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Security ---------------------------------------------------------------
# Master key for AES-256-GCM encryption of OAuth tokens. 32 random bytes hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# --- Dev-only login fallback (never enable in production) --------------------
AUTH_ALLOW_DEV_LOGIN="false"
DEV_LOGIN_EMAIL=""

# --- Sending defaults -------------------------------------------------------
EMAIL_DEFAULT_DAILY_LIMIT="50"
REPLY_SYNC_INTERVAL_MINUTES="5"
