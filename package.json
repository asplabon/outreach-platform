{
  "name": "outreach-platform",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "sharp": true,
    "@tailwindcss/oxide": true,
    "unrs-resolver": true,
    "msgpackr-extract": true
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx workers/start-worker.ts",
    "worker:email": "tsx workers/email-worker.ts",
    "worker:reply": "tsx workers/reply-worker.ts",
    "worker:sheets": "tsx workers/sheet-sync-worker.ts",
    "worker:ai": "tsx workers/ai-worker.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-table": "^9.1.2",
    "bullmq": "^6.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "googleapis": "^174.0.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.31.0",
    "next": "^15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "openai": "^7.4.0",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
